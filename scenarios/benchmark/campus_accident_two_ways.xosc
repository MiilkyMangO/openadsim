              <StartTrigger>
                <ConditionGroup>
                  <Condition name="oncoming_8_event_start" delay="0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="all">
                        <EntityRef entityRef="ego_vehicle" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeDistanceCondition entityRef="accident_patrol" freespace="true" relativeDistanceType="euclidianDistance" rule="lessThan" value="30" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition conditionEdge="none" delay="0" name="act_start">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterThan" value="0" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger>
          <ConditionGroup>
            <Condition conditionEdge="rising" delay="0.0" name="StoptriggerTime">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterThan" value="150" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
          <ConditionGroup>
            <Condition conditionEdge="rising" delay="0.0" name="StoptriggerEgoRoute">
              <ByValueCondition>
                <StoryboardElementStateCondition storyboardElementRef="event_ego_vehicle" state="completeState" storyboardElementType="event" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StopTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="criteria_RunningStopTest" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <ParameterCondition parameterRef="" value="0" rule="lessThan" />
          </ByValueCondition>
        </Condition>
        <Condition name="criteria_RunningRedLightTest" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <ParameterCondition parameterRef="" value="0" rule="lessThan" />
          </ByValueCondition>
        </Condition>
        <Condition name="criteria_CollisionTest" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <ParameterCondition parameterRef="" value="0" rule="lessThan" />
          </ByValueCondition>
        </Condition>
        <Condition name="criteria_OnSidewalkTest" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <ParameterCondition parameterRef="" value="0" rule="lessThan" />
          </ByValueCondition>
        </Condition>
        <Condition name="criteria_DrivenDistanceTest" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <ParameterCondition parameterRef="distance_success" value="30" rule="greaterThan" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
